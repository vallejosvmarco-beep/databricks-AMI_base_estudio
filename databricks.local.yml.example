# ============================================================
# CONFIGURACION LOCAL DEL BUNDLE AMI_base (no versionar)
# ============================================================
# Uso:
#   cp databricks.local.yml.example databricks.local.yml
#   Edita los valores de tu entorno. databricks.local.yml esta en .gitignore.
#
# Se usa override a nivel de target: los defaults de databricks.yml
# no se sobreescriben desde archivos incluidos.
# ============================================================

targets:
  free_dev:
    variables:
      catalog: main  # CAMBIA ESTO por tu catalogo (databricks catalogs list)

      # --------------------------------------------------------
      # ESQUEMAS (opcional). Por defecto: alunizaje, bronce, plata, plata_analisis
      # --------------------------------------------------------
      # schema_alunizaje: landing
      # schema_bronce: bronze
      # schema_plata: silver
      # schema_analisis: silver_analytics

      # --------------------------------------------------------
      # LISTAS OFICIALES TMT/TMTB (opcional)
      # Excel en /Volumes/<catalog>/<schema_alunizaje>/<volume_oficiales>/{tmt|tmtb}/<periodo>/<mes>
      # --------------------------------------------------------
      # volume_oficiales: datos_oficiales
      # oficial_periodo: "2026"
      # oficial_mes: "06"

      # --------------------------------------------------------
      # LANDING AMI (opcional; PME se ingiere en el bundle PME_base)
      # Parquet en <ami_base_path>/<carga|consumo|tension>/source=AMI/format=PARQUET/periodo=<yyyy>/mes=<m>
      # El bronce solo guarda la ventana configurada (ingesta incremental + retencion).
      # ami_periodo/ami_mes: "ultimo" (ultimo mes del landing) o un mes fijo.
      # ami_meses_historial: "1", "N" o "todos".
      # --------------------------------------------------------
      # ami_base_path: /Volumes/datosami/datos/vol_alunizaje/ami
      # ami_periodo: ultimo
      # ami_mes: ultimo
      # ami_meses_historial: "3"   # ultimos 3 meses disponibles

      # --------------------------------------------------------
      # PERIODO DE CALIDAD -> plata_950 (opcional)
      # --------------------------------------------------------
      # periodo_inicio: auto        # o "2025-12-01"
      # periodo_fin: auto           # o "2025-12-31"
